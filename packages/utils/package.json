{
  "name": "@modern-kit/utils",
  "sideEffects": false,
  "version": "3.3.0",
  "description": "modern-kit/utils",
  "author": "ssi02014 <ssi02014@naver.com>",
  "license": "MIT",
  "bugs": "https://github.com/modern-agile-team/modern-kit/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/modern-agile-team/modern-kit"
  },
  "homepage": "https://modern-agile-team.github.io/modern-kit",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./dist/*": {
      "types": "./dist/*",
      "require": "./dist/*",
      "import": "./dist/*"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "require": "./dist/*/index.cjs",
      "import": "./dist/*/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest --typecheck",
    "test:run": "vitest run --coverage --typecheck",
    "test:heap": "vitest run --logHeapUsage --reporter=verbose 2>&1 | node ../../scripts/heap-summary.mjs",
    "test:heap:report": "yarn test:heap > heap-report.txt",
    "test:bench": "vitest bench",
    "build": "rm -rf dist && rolldown -c",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modern-kit/types": "workspace:^",
    "@types/lodash-es": "^4.17.12",
    "@vitest/coverage-istanbul": "catalog:stable/test",
    "eslint": "catalog:stable/eslint",
    "happy-dom": "catalog:stable/test",
    "lodash-es": "^4.17.21",
    "rolldown": "catalog:stable/rolldown",
    "rolldown-plugin-dts": "catalog:stable/rolldown",
    "typescript": "catalog:stable/typescript",
    "vite": "catalog:stable/vite",
    "vitest": "catalog:stable/test"
  },
  "engines": {
    "node": ">=24",
    "yarn": ">=4"
  },
  "packageManager": "yarn@4.14.1",
  "keywords": [
    "react",
    "next",
    "utils",
    "component",
    "ui",
    "hooks",
    "custom hooks"
  ],
  "gitHead": "7722785374b897572934e335817ec297ad45a943"
}
