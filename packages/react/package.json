{
  "name": "@modern-kit/react",
  "sideEffects": false,
  "version": "3.1.0",
  "description": "modern-kit/react",
  "author": "ssi02014 <ssi02014@naver.com>",
  "license": "MIT",
  "bugs": "https://github.com/modern-agile-team/modern-kit/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/modern-agile-team/modern-kit"
  },
  "homepage": "https://modern-agile-team.github.io/modern-kit",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./dist/*": {
      "types": "./dist/*",
      "require": "./dist/*",
      "import": "./dist/*"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "require": "./dist/*/index.cjs",
      "import": "./dist/*/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest --typecheck",
    "test:run": "vitest run --coverage --typecheck",
    "build": "rm -rf dist && rolldown -c",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-istanbul": "^4.1.5",
    "eslint": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^29.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rolldown": "^1.0.0",
    "rolldown-plugin-dts": "^0.25.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@modern-kit/utils": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24",
    "yarn": ">=4"
  },
  "packageManager": "yarn@4.14.1",
  "keywords": [
    "react",
    "next",
    "utils",
    "component",
    "ui",
    "hooks",
    "custom hooks"
  ],
  "gitHead": "f451da4fef108695b343911200ec95ee34da4e97"
}
