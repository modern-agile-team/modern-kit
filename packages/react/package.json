{
  "name": "@modern-kit/react",
  "sideEffects": false,
  "version": "3.2.0",
  "description": "modern-kit/react",
  "author": "ssi02014 <ssi02014@naver.com>",
  "license": "MIT",
  "bugs": "https://github.com/modern-agile-team/modern-kit/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/modern-agile-team/modern-kit"
  },
  "homepage": "https://modern-agile-team.github.io/modern-kit",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./dist/*": {
      "types": "./dist/*",
      "require": "./dist/*",
      "import": "./dist/*"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "require": "./dist/*/index.cjs",
      "import": "./dist/*/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest --typecheck",
    "test:run": "vitest run --coverage --typecheck",
    "test:heap": "vitest run --logHeapUsage --reporter=verbose 2>&1 | node ../../scripts/heap-summary.mjs",
    "test:heap:report": "yarn test:heap > heap-report.txt",
    "build": "rm -rf dist && rolldown -c",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "catalog:stable/react",
    "@types/react-dom": "catalog:stable/react",
    "@vitest/coverage-istanbul": "catalog:stable/test",
    "eslint": "catalog:stable/eslint",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "catalog:stable/test",
    "react": "catalog:stable/react",
    "react-dom": "catalog:stable/react",
    "rolldown": "catalog:stable/rolldown",
    "rolldown-plugin-dts": "catalog:stable/rolldown",
    "typescript": "catalog:stable/typescript",
    "vite": "catalog:stable/vite",
    "vitest": "catalog:stable/test"
  },
  "dependencies": {
    "@modern-kit/utils": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24",
    "yarn": ">=4"
  },
  "packageManager": "yarn@4.14.1",
  "keywords": [
    "react",
    "next",
    "utils",
    "component",
    "ui",
    "hooks",
    "custom hooks"
  ],
  "gitHead": "f451da4fef108695b343911200ec95ee34da4e97"
}
